{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  // "include": ["src/**/*", "src/types/**/*.d.ts"],
  "include": [
    "src/**/*",
    "src/types/**/*.d.ts",
    "tests/**/*"
  ],
  // "exclude": ["node_modules", "dist","tests"]
  "exclude": ["node_modules", "dist"]
}